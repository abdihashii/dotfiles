{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "diff_view_style": "unified",
  "format_on_save": "off",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "vim_mode": false,
  "relative_line_numbers": "enabled",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "pi-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "effort": "xhigh",
        "mode": "plan",
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Light Charmed Icons",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 18,
  "ui_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "ui_font_weight": 200,
  "buffer_font_size": 18,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "buffer_font_weight": 200,
  "terminal": {
    "font_size": 18,
    "font_family": "JetBrainsMonoNL Nerd Font Mono",
    "font_weight": 200,
  },
  "agent_buffer_font_size": 18,
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "Tokyo Night",
  },
  "status_bar": {
    "experimental.show": false,
  },
  "tab_size": 2,
  "colorize_brackets": true,
  "gutter": {
    "runnables": false,
    "breakpoints": false,
    "min_line_number_digits": 0,
  },
  "title_bar": {
    "show_sign_in": false,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_menu": false,
    "show_branch_name": false,
    "show_branch_status_icon": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "project_panel": {
    "dock": "right",
    "git_status_indicator": true,
    "default_width": 400,
    "indent_guides": {
      "show": "never",
    },
    "hide_root": true,
    "auto_fold_dirs": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "git_panel": {
    "default_width": 400,
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "selection_highlight": false,
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "...",
      ],
    },
  },
}
